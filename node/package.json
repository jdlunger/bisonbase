{
  "name": "@bisonbase/server",
  "version": "0.1.0",
  "description": "Backend-as-a-service in a box: per-user files and SQLite databases over HTTP, with a web UI and passkey auth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdlunger/bisonbase.git",
    "directory": "node"
  },
  "homepage": "https://github.com/jdlunger/bisonbase#readme",
  "bugs": "https://github.com/jdlunger/bisonbase/issues",
  "keywords": [
    "sqlite",
    "backend",
    "passkeys",
    "webauthn",
    "self-hosted",
    "napi"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "bisonbase": "bin/bisonbase.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "bisonbase",
    "packageName": "@bisonbase/binding",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "test": "node --test",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "version": "napi version && git add npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
